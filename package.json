{
  "name": "@hiosdra/mcp-manager",
  "version": "0.1.0",
  "description": "MCP Manager - Centralized MCP server configuration tool",
  "main": "dist/main/main.js",
  "bin": {
    "mcp-manager": "bin/mcp-manager.js"
  },
  "files": [
    "bin/",
    "dist/",
    "index.html",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "npm run rebuild:electron && npm run build:main && concurrently \"vite\" \"vite build --config vite.main.config.ts --watch\" \"sleep 2 && electron .\"",
    "dev:docs": "vite --config docs/vite.config.ts",
    "dev:renderer": "vite",
    "dev:main": "vite build --config vite.main.config.ts --watch",
    "clean": "rm -rf dist node_modules/.cache node_modules/.vite test-results && npm run build",
    "build": "vite build && vite build --config vite.main.config.ts",
    "build:docs": "vite build --config docs/vite.config.ts",
    "build:renderer": "vite build",
    "build:main": "vite build --config vite.main.config.ts",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3",
    "test": "npm run rebuild:node && vitest run",
    "test:e2e": "playwright test",
    "preview:docs": "vite preview --config docs/vite.config.ts",
    "test:watch": "npm run rebuild:node && vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "better-sqlite3": "^12.6.2",
    "electron": "^40.8.0",
    "jsonc-parser": "^3.3.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "xml2js": "^0.6.2",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@playwright/test": "^1.58.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/xml2js": "^0.4.14",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "electron-builder": "^26.8.1",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "build": {
    "appId": "com.mcp-manager.app",
    "productName": "MCP Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
